# Byte Force Environment Variables Example

# Backend Database Settings (MySQL/MariaDB)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=byte_force
DB_USER=root
DB_PASS=

# JWT Secrets
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRY=86400

# AI Microservice URL
AI_SERVICE_URL=http://127.0.0.1:8000

# Frontend Configuration
VITE_API_URL=http://192.168.0.104:8080/api
VITE_APP_NAME="Byte Force - HomeGenie AI"

